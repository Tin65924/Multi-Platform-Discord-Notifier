# Copy to .env and fill - NEVER commit .env
# Prod (Render + Neon): set these in the Render dashboard instead of a file.
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/neondb?ssl=require
APP_SECRET_KEY=change-me-32chars-min
# External cron needs no secret — point cron-job.org at /api/cron/poll directly.
# First-run superadmin (created automatically if no users exist)
SUPERADMIN_USER=superadmin
SUPERADMIN_PASS=change-me-strong-password
# Global Discord defaults (or set them in the dashboard Defaults tab)
DASHBOARD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Optional Cloudflare Worker relay (see worker/README.md). When both are set,
# posts go via the relay instead of Discord directly (bypasses flagged host IPs).
RELAY_URL=
RELAY_SECRET=
PING_ROLE_ID=
# Message template ({discord} = mention when User ID is set, else @text)
CUSTOM_MESSAGE="{discord} is LIVE!"
EMBED_IMAGE_URL=
PUBLIC_BASE_URL=
# --- TikTok fetch auth (recommended) ---
# 1. Log in at tiktok.com in your browser
# 2. F12 -> Application -> Cookies -> https://www.tiktok.com -> copy "sessionid"
# 3. Paste below. This is your TikTok login: keep in .env, never commit/share.
TIKTOK_SESSION_ID=
# Automatic cookie minting (headless browser, hourly). Needs Playwright
# browsers installed — leave "off" on Render, "on" for local zero-maintenance.
TT_COOKIE_PROVIDER=off
# Backoff after a failed cookie mint before retrying (seconds)
TT_COOKIE_RETRY_SECONDS=1800
# --- Twitch live checks (Helix app token, client-credentials, no user OAuth) ---
# Register a free app at https://dev.twitch.tv/console -> get client ID + secret.
# Read-only stream status needs no scopes. Server-side only: never commit/share.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# --- Kick live checks (official API app token, no user login, no scopes) ---
# Create an app at https://dev.kick.com -> get client ID + secret.
# Redirect URL unused (leave blank or http://localhost:8000).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# --- YouTube live-check confirm step (Data API v3 key, verify-only) ---
# Detection itself is keyless; the key confirms candidate streams via videos.list
# (cheap: ~1 unit per batched check). Google Cloud Console -> enable YouTube
# Data API v3 -> API key. NEVER use search.list for polling (100/day limit).
YOUTUBE_API_KEY=
CHECK_INTERVAL_SECONDS=45
CHECK_JITTER_SECONDS=10
PER_CHECK_SLEEP_SECONDS=1.0
MAX_CREATORS=60
WEBHOOK_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
PORT=8000
